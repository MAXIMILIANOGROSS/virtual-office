NEXT_PUBLIC_SUPABASE_KEY=            # clave "anon" / publishable
SUPABASE_SERVICE_ROLE_KEY=           # SOLO servidor (ciclo 24/7, entregables). Nunca la subas al repositorio.

# ===== Propietario (obligatorio) =====
OWNER_EMAIL=                         # correo verificado que puede entrar a /oficina. Sin esto NADIE entra.
# OWNER_USER_ID=                     # opcional: fija también el id inmutable del usuario

# ===== Ciclo 24/7 (opcional) =====
CRON_SECRET=                         # clave larga y aleatoria; la usan el workflow de GitHub Actions y el worker de vídeo

